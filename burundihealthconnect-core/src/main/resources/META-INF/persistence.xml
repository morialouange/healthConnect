<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Unité de persistance JTA — gérée par le conteneur GlassFish.
        Les EJB @Stateless injectent l'EntityManager via :
            @PersistenceContext(unitName = "bhcPU")
        AUCUN appel JDBC direct n'est fait dans le code applicatif.

        IMPORTANT (à faire sur GlassFish avant déploiement) :
        1. Créer un Connection Pool JDBC nommé "BHCPool"
           (driver com.mysql.cj.jdbc.MysqlDataSource, base burundihealthconnect_db)
        2. Créer une JDBC Resource (JNDI) nommée "jdbc/BHCDataSource"
           pointant vers ce pool
        Ces deux étapes se font dans la console d'admin GlassFish,
        PAS dans ce fichier (séparation infra / code).
    -->
    <persistence-unit name="bhcPU" transaction-type="JTA">
        <jta-data-source>jdbc/BHCDataSource</jta-data-source>

        <!-- Toutes les entités sont listées explicitement (pas de scan implicite) -->
        <class>com.burundihealthconnect.entity.EtablissementSante</class>
        <class>com.burundihealthconnect.entity.Utilisateur</class>
        <class>com.burundihealthconnect.entity.Patient</class>
        <class>com.burundihealthconnect.entity.DossierMedical</class>
        <class>com.burundihealthconnect.entity.Medecin</class>
        <class>com.burundihealthconnect.entity.EtabliUtilisateur</class>
        <class>com.burundihealthconnect.entity.Service</class>
        <class>com.burundihealthconnect.entity.RendezVous</class>
        <class>com.burundihealthconnect.entity.DisponibiliteSemaine</class>
        <class>com.burundihealthconnect.entity.CreneauDisponible</class>
        <class>com.burundihealthconnect.entity.CongeMedecin</class>
        <class>com.burundihealthconnect.entity.Notification</class>
        <class>com.burundihealthconnect.entity.Consultation</class>
        <class>com.burundihealthconnect.entity.Ordonance</class>
        <class>com.burundihealthconnect.entity.LignePrescription</class>
        <class>com.burundihealthconnect.entity.Referenement</class>
        <class>com.burundihealthconnect.entity.AccesDossier</class>
        <class>com.burundihealthconnect.entity.HistoriqueModification</class>
        <class>com.burundihealthconnect.entity.AuditLog</class>
        <class>com.burundihealthconnect.entity.JourTravail</class>
        <class>com.burundihealthconnect.entity.HistoriqueRdv</class>

        <properties>
            <!-- Le schéma est déjà créé par medicentral_script_v2.sql -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create-or-extend-tables"/>
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>